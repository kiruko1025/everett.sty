% Semantic theorem settings keep the existing interface and numbering intact.
% Macros (rather than frozen color copies) preserve late palette overrides.
\def\everettDefinitionColor{ctpMauve}
\def\everettDefinitionFill{ctpMauve!8!ctpBase}
\def\everettExampleColor{ctpTeal}
\def\everettExampleFill{ctpTeal!8!ctpBase}
\def\everettResultColor{ctpMauve}
\def\everettResultFill{ctpMauve!10!ctpBase}
\def\everettRemarkColor{ctpYellow}
\def\everettProofColor{ctpMauve}
\def\everettProofFill{ctpBase}
\def\everettExplanationColor{ctpTeal}
\def\everettExplanationFill{ctpTeal!3!ctpBase}
\def\everettTheoremRule{2pt}
\def\everettDefinitionName{definition}
\def\everettExampleName{example}
\def\everettPropositionName{proposition}
\def\everettTheoremName{theorem}
\def\everettLemmaName{lemma}
\def\everettCorollaryName{corollary}
\mdfdefinestyle{everettRemarkFrame}{}
\mdfdefinestyle{everettProofFrame}{}
\ifeverettpanbook
  \def\everettDefinitionColor{bookAccent}
  \def\everettDefinitionFill{bookAccent!6!ctpBase}
  \def\everettExampleColor{bookGreen}
  \def\everettExampleFill{bookGreen!6!ctpBase}
  \def\everettResultColor{bookBlue}
  \def\everettResultFill{bookBlue!7!ctpBase}
  \def\everettRemarkColor{bookGold}
  \def\everettProofColor{bookInk}
  \def\everettProofFill{ctpBase}
  \def\everettExplanationColor{bookGreen}
  \def\everettExplanationFill{bookGreen!3!ctpBase}
  \def\everettTheoremRule{3pt}
  \def\everettDefinitionName{Definition}
  \def\everettExampleName{Example}
  \def\everettPropositionName{Proposition}
  \def\everettTheoremName{Theorem}
  \def\everettLemmaName{Lemma}
  \def\everettCorollaryName{Corollary}
  \mdfdefinestyle{everettRemarkFrame}{backgroundcolor=bookGold!10!ctpBase}
  \mdfdefinestyle{everettProofFrame}{hidealllines=true,
    innerleftmargin=0pt,innerrightmargin=0pt}
  \renewcommand{\qedsymbol}{\ensuremath{\blacksquare}}
\fi


\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{\everettDefinitionColor},
    bodyfont=\normalfont,
    mdframed={
        linewidth=\everettTheoremRule,
        rightline=false, topline=false, bottomline=false,
        linecolor=\everettDefinitionColor,
        backgroundcolor=\everettDefinitionFill,
    }
]{thmgreenbox} % definitions

\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{\everettExampleColor},
    bodyfont=\normalfont,
    mdframed={
        linewidth=\everettTheoremRule,
        rightline=false, topline=false, bottomline=false,
        linecolor=\everettExampleColor,
        backgroundcolor=\everettExampleFill,
    }
]{thmbluebox} % examples

\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{\everettRemarkColor},
    bodyfont=\normalfont,
    mdframed={
        style=everettRemarkFrame,
        linewidth=\everettTheoremRule,
        rightline=false, topline=false, bottomline=false,
        linecolor=\everettRemarkColor
    }
]{thmblueline} % remarks / notes (line only)

\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{\everettResultColor},
    bodyfont=\normalfont,
    mdframed={
        linewidth=\everettTheoremRule,
        rightline=false, topline=false, bottomline=false,
        linecolor=\everettResultColor,
        backgroundcolor=\everettResultFill,
    }
]{thmredbox} % theorem / lemma / proposition / corollary

\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{\everettProofColor},
    bodyfont=\normalfont,
    numbered=no,
    mdframed={
        linewidth=2pt,
        rightline=false, topline=false, bottomline=false,
        linecolor=\everettProofColor,
        backgroundcolor=\everettProofFill,
        style=everettProofFrame,
    },
    qed=\qedsymbol
]{thmproofbox}

\declaretheoremstyle[
    headfont=\bfseries\sffamily\color{\everettExplanationColor},
    bodyfont=\normalfont,
    numbered=no,
    mdframed={
        linewidth=2pt,
        rightline=false, topline=false, bottomline=false,
        linecolor=\everettExplanationColor,
        backgroundcolor=\everettExplanationFill,
    },
]{thmexplanationbox} % explanations


\declaretheorem[style=thmgreenbox, name=\everettDefinitionName]{definition}
\declaretheorem[style=thmbluebox, numbered=no, name=\everettExampleName]{eg}
\declaretheorem[style=thmredbox, name=\everettPropositionName]{prop}
\declaretheorem[style=thmredbox, name=\everettTheoremName]{theorem}
\declaretheorem[style=thmredbox, name=\everettLemmaName]{lemma}
\declaretheorem[style=thmredbox, numbered=no, name=\everettCorollaryName]{corollary}

% Keep the optional amsthm proof title (also used by macro.sty's soln).
% thmtools expands the heading when declaring it; keep this name dynamic.
\protected\def\everettproofname{\proofname}
\declaretheorem[style=thmproofbox, name=\everettproofname]{replacementproof}
\renewenvironment{proof}[1][\proofname]{%
    \renewcommand{\everettproofname}{#1}%
    \vspace{-12pt}\begin{replacementproof}%
}{\end{replacementproof}}


\declaretheorem[style=thmexplanationbox, name=Explanation]{tmpexplanation}
\newenvironment{explanation}[1][]{%
    \vspace{-12pt}%
    \ifstrempty{#1}{\begin{tmpexplanation}}{\begin{tmpexplanation}[#1]}%
}{\end{tmpexplanation}}

\declaretheorem[style=thmblueline, numbered=no, name=Remark]{remark}
\declaretheorem[style=thmblueline, numbered=no, name=Note]{note}

